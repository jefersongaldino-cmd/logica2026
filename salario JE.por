programa
{
	
	funcao inicio()
	{
	  cadeia nome
	  inteiro valor_venda, salario_final

	  	inteiro salario=2000
		escreva("Nome do vendedor:")
		leia(nome)
		escreva("Total de vendas do mês:")
		leia(valor_venda)
		escreva("Comissão",valor_venda/10)
		
	}
	funcao inteiro soma(inteiro a, inteiro b){
		inteiro resultado
		resultado = a+b
		retorne resultado
	}
}
