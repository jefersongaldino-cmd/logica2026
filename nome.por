programa
{
	
	funcao inicio()
	{
		cadeia nomes[5]
	para(inteiro i=0; i<5; i++){
		escreva("Nomes:")
		leia(nomes[i])
		}
		escreva("Primeiro Nome:", nomes[0], "Último Nome:",nomes[4])
	}
}
